# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# LaTeX build products (PDFs are committed deliberately)
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# Large raw data files: kept out of git, pinned by sha256 in data/MANIFEST.json
problems/*/data/raw/*.cov
problems/*/data/raw/*.fits
problems/*/data/raw/*.npy

# OS
.DS_Store
problems/*/data/cache/
problems/*/results/*.npy
problems/*/src/*/__pycache__/
problems/*/tests/__pycache__/

# certificate dual vectors (hundreds of MB); state.json and result.json are committed
problems/*/results/certificates/lkr_*/*.npz

# small released files needed for replay (override the generic patterns)
!problems/P9/data/raw/mu_mat_union3_cosmo=2_mu.fits
problems/*/results/certificates/archive_lkr_*/*.npz
